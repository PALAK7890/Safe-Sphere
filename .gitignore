# ============================================================
# SafeSphere AI — .gitignore
# ============================================================

# --- SECRETS (NEVER COMMIT) ---
.env
*.env
.env.local
.env.production
.env.staging
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Testing ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
test-results/

# --- Type Checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# --- Database ---
*.sql.bak
pg_data/
pgdata/
*.dump

# --- Node.js / Frontend ---
node_modules/
.next/
out/
dist/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp.*

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Docker ---
.docker/

# --- OSRM data (large binary files) ---
*.osm.pbf
*.osrm
*.osrm.*
india-latest.osm.pbf

# --- GTFS feeds (downloaded at runtime) ---
*.zip
gtfs_feeds/

# --- Geospatial data (large files) ---
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.geojson.bak
india_gadm/

# --- Logs ---
*.log
logs/
celerybeat-schedule
celerybeat.pid

# --- Alembic ---
alembic/versions/*.pyc

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Temp ---
tmp/
temp/
scratch/
