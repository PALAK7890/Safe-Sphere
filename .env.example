# ============================================================
# SafeSphere AI — Environment Variables (EXAMPLE / PLACEHOLDER)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. This file (.env.example) contains
# only placeholder values and is safe to commit.
# ============================================================

# --- PostgreSQL / PostGIS ---
DATABASE_URL=postgresql+asyncpg://safesphere:CHANGE_ME@localhost:5432/safesphere_db
POSTGRES_DB=safesphere_db
POSTGRES_USER=safesphere
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Application Settings ---
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_USE_RANDOM_64_CHAR_HEX
DEBUG=true                   # Set false in production
ALLOWED_ORIGINS=http://localhost:3000

# --- Data.gov.in API ---
# Register at: https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY_HERE

# --- India Meteorological Department (IMD) ---
# Register at: https://api.imd.gov.in
IMD_API_KEY=YOUR_IMD_API_KEY_HERE

# --- OpenWeatherMap (backup weather / AQI) ---
# Register at: https://openweathermap.org/api
OWM_API_KEY=YOUR_OWM_API_KEY_HERE

# --- Open-Meteo (primary weather — no key required for free tier) ---
# No key needed for development. For commercial (>10K calls/day):
# OPEN_METEO_API_KEY=YOUR_COMMERCIAL_OPEN_METEO_KEY
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AQI_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# --- OTD Delhi GTFS Real-Time ---
# Register at: https://otd.delhi.gov.in
OTD_DELHI_API_KEY=YOUR_OTD_DELHI_API_KEY_HERE
OTD_DELHI_GTFS_RT_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb

# --- LocationIQ Geocoding ---
# Register at: https://locationiq.com
LOCATIONIQ_API_KEY=YOUR_LOCATIONIQ_API_KEY_HERE

# --- Map Tiles ---
# Option A: Stadia Maps (register at client.stadiamaps.com)
STADIA_MAPS_API_KEY=YOUR_STADIA_MAPS_API_KEY_HERE
# Option B: MapTiler (register at cloud.maptiler.com)
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY_HERE

# --- NHFR (National Health Facility Registry) ---
# Register at: https://nhfr.nhp.gov.in
NHFR_API_KEY=YOUR_NHFR_API_KEY_HERE

# --- Overpass API ---
# No key needed. Set User-Agent below.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=SafeSphere-AI/1.0 (contact@yourdomain.com)

# --- OSRM Routing (self-hosted) ---
OSRM_BASE_URL=http://localhost:5000

# --- Pilot Geographic Scope ---
DELHI_BBOX_SOUTH=28.40
DELHI_BBOX_WEST=76.83
DELHI_BBOX_NORTH=28.88
DELHI_BBOX_EAST=77.35
SONIPAT_BBOX_SOUTH=28.87
SONIPAT_BBOX_WEST=76.88
SONIPAT_BBOX_NORTH=29.07
SONIPAT_BBOX_EAST=77.15

# --- PCR / Emergency Integrations ---
# Leave empty until formal authorization is received from police authorities.
# When is_simulated = true in authorized_emergency_integrations, ALL vehicle
# data MUST be displayed with a "SIMULATED — NOT LIVE" label.
PCR_FEED_AUTHORIZED=false
PCR_FEED_ENDPOINT=
PCR_FEED_API_KEY=

# --- AI / RAG Agent ---
# OpenAI-compatible API key for LLM agent
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL=gemini-2.0-flash   # or gpt-4o, claude-3-5-sonnet, etc.
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Security ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | text
